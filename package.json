### 4. `src/main.jsx`
```jsx
import React from 'react'
import ReactDOM from 'react-dom/client'
import './styles.css'

function App() {
  return (
    <div className="card">
      <h1>Office Task Report Dashboard</h1>
      <p>Frontend successfully connected with Cloudflare Pages / Vercel.</p>
    </div>
  )
}

ReactDOM.createRoot(document.getElementById('root')).render(
  <React.StrictMode>
    <App />
  </React.StrictMode>,
)
```[cite: 2]

